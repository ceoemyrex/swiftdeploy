# Generated by SwiftDeploy - DO NOT EDIT MANUALLY
# Generated from: manifest.yaml

version: '3.9'

services:
  {{SERVICE_NAME}}:
    image: {{SERVICE_IMAGE}}
    container_name: {{SERVICE_NAME}}
    ports:
      # Service port NOT exposed (only via Nginx)
      - "{{SERVICE_PORT}}"
    environment:
      MODE: {{MODE}}
      APP_VERSION: {{APP_VERSION}}
      APP_PORT: {{SERVICE_PORT}}
    networks:
      - {{NETWORK_NAME}}
    restart_policy:
      condition: {{RESTART_POLICY}}
      delay: 5s
      max_attempts: 3
      window: 120s
    healthcheck:
      test: ["CMD", "python", "-c", "import requests; requests.get('http://localhost:{{SERVICE_PORT}}/healthz')"]
      interval: {{HEALTHCHECK_INTERVAL}}s
      timeout: {{HEALTHCHECK_TIMEOUT}}s
      retries: {{HEALTHCHECK_RETRIES}}
      start_period: 10s
    volumes:
      - logs:/app/logs
    logging:
      driver: {{LOG_DRIVER}}
      options:
        max-size: "{{LOG_MAX_SIZE}}"
        max-file: "{{LOG_MAX_FILE}}"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    user: appuser

  nginx:
    image: {{NGINX_IMAGE}}
    container_name: nginx
    ports:
      - "{{NGINX_PORT}}:{{NGINX_PORT}}"
    volumes:
      - ./generated/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./logs/nginx:/var/log/nginx
    networks:
      - {{NETWORK_NAME}}
    depends_on:
      {{SERVICE_NAME}}:
        condition: service_healthy
    restart_policy:
      condition: {{RESTART_POLICY}}
    logging:
      driver: {{LOG_DRIVER}}
      options:
        max-size: "{{LOG_MAX_SIZE}}"
        max-file: "{{LOG_MAX_FILE}}"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O-", "http://localhost:{{NGINX_PORT}}/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  {{NETWORK_NAME}}:
    driver: {{NETWORK_DRIVER}}

volumes:
  logs:
    driver: local
