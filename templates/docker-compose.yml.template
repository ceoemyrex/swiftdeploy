# Generated by SwiftDeploy - DO NOT EDIT MANUALLY
# Generated from: manifest.yaml

version: '3.9'

services:
  api:
    image: {{SERVICE_IMAGE}}
    container_name: api
    ports:
      - "{{SERVICE_PORT}}"
    environment:
      MODE: {{MODE}}
      APP_VERSION: {{APP_VERSION}}
      APP_PORT: {{SERVICE_PORT}}
    networks:
      - {{NETWORK_NAME}}
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "python -c 'import urllib.request; urllib.request.urlopen(\"http://localhost:{{SERVICE_PORT}}/healthz\")'"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    volumes:
      - logs:/app/logs
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    user: appuser

  nginx:
    image: {{NGINX_IMAGE}}
    container_name: nginx
    ports:
      - "{{NGINX_PORT}}:{{NGINX_PORT}}"
    volumes:
      - {{NGINX_CONF_PATH}}:/etc/nginx/nginx.conf:ro
      - {{LOGS_NGINX_PATH}}:/var/log/nginx
    networks:
      - {{NETWORK_NAME}}
    depends_on:
      api:
        condition: service_healthy
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://localhost:{{NGINX_PORT}}/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  {{NETWORK_NAME}}:
    driver: {{NETWORK_DRIVER}}

volumes:
  logs:
    driver: local
