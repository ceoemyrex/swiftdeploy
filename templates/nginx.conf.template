# Generated from: manifest.yaml

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging format
    log_format swiftdeploy '$time_iso8601 | $status | ${request_time}s | $upstream_addr | $request';
    access_log /var/log/nginx/access.log swiftdeploy;

    # Timeouts
    proxy_connect_timeout {{PROXY_CONNECT_TIMEOUT}}s;
    proxy_send_timeout {{PROXY_TIMEOUT}}s;
    proxy_read_timeout {{PROXY_READ_TIMEOUT}}s;

    # Performance
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 20M;

    # Upstream service
    upstream api_backend {
        server {{SERVICE_NAME}}:{{SERVICE_PORT}};
        keepalive 32;
    }

    # Error response handler
    server {
        listen {{NGINX_PORT}} default_server;
        server_name _;

        # Custom error pages with JSON
        error_page 502 = @error502;
        error_page 503 = @error503;
        error_page 504 = @error504;

        location @error502 {
            default_type application/json;
            return 502 '{"error":"Bad Gateway","code":502,"service":"upstream","contact":"devops@example.com"}';
        }

        location @error503 {
            default_type application/json;
            return 503 '{"error":"Service Unavailable","code":503,"service":"api","contact":"devops@example.com"}';
        }

        location @error504 {
            default_type application/json;
            return 504 '{"error":"Gateway Timeout","code":504,"service":"upstream","contact":"devops@example.com"}';
        }

        # Proxy all requests to upstream
        location / {
            proxy_pass http://api_backend;
            proxy_http_version 1.1;

            # Headers
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Deployed-By swiftdeploy;

            # Forward canary mode header from upstream
            proxy_pass_header X-Mode;

            # Connection settings
            proxy_set_header Connection "";
            proxy_buffering off;
        }
    }
}
