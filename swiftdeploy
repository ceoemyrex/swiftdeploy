#!/usr/bin/env python3
"""SwiftDeploy CLI Tool"""

import os
import sys
import json
import yaml
import subprocess
import time
from pathlib import Path

PROJECT_ROOT = Path(__file__).parent.absolute()
MANIFEST_FILE = PROJECT_ROOT / "manifest.yaml"
GENERATED_DIR = PROJECT_ROOT / "generated"
TEMPLATES_DIR = PROJECT_ROOT / "templates"
LOGS_DIR = PROJECT_ROOT / "logs"

def log_success(msg):
    print(f"✅ {msg}")

def log_error(msg):
    print(f"❌ {msg}")
    sys.exit(1)

def load_manifest():
    if not MANIFEST_FILE.exists():
        log_error(f"Manifest not found: {MANIFEST_FILE}")
    with open(MANIFEST_FILE, 'r') as f:
        return yaml.safe_load(f)

def get_value(obj, path, default=None):
    keys = path.split('.')
    val = obj
    for key in keys:
        if isinstance(val, dict):
            val = val.get(key)
        else:
            return default
    return val if val is not None else default

def render_template(template_name, variables):
    template_file = TEMPLATES_DIR / template_name
    if not template_file.exists():
        log_error(f"Template not found: {template_file}")
    with open(template_file, 'r') as f:
        content = f.read()
    for key, value in variables.items():
        placeholder = f"{{{{{key}}}}}"
        content = content.replace(placeholder, str(value))
    return content

def init():
    print("\n" + "="*60)
    print("INITIALIZING SWIFTDEPLOY")
    print("="*60 + "\n")
    
    try:
        manifest = load_manifest()
        log_success("Manifest loaded")
        
        GENERATED_DIR.mkdir(exist_ok=True)
        log_success(f"Created {GENERATED_DIR}")
        
        LOGS_DIR.mkdir(exist_ok=True)
        log_success(f"Created {LOGS_DIR}")
        
        service_image = get_value(manifest, 'services.image')
        service_port = get_value(manifest, 'services.port')
        service_mode = get_value(manifest, 'services.mode', 'stable')
        nginx_image = get_value(manifest, 'nginx.image')
        nginx_port = get_value(manifest, 'nginx.port')
        proxy_timeout = get_value(manifest, 'nginx.proxy_timeout', 30)
        network_name = get_value(manifest, 'network.name')
        network_driver = get_value(manifest, 'network.driver_type')
        app_version = get_value(manifest, 'app_version', '1.0.0')
        
        print(f"\nConfiguration:")
        print(f"  Service: {service_image}:{service_port}")
        print(f"  Mode: {service_mode}")
        print(f"  Nginx: {nginx_image}:{nginx_port}")
        print(f"  Network: {network_name} ({network_driver})\n")
        
        print(f"[RENDER] Generating nginx.conf...")
        nginx_vars = {
            'SERVICE_NAME': 'api',
            'SERVICE_PORT': str(service_port),
            'NGINX_PORT': str(nginx_port),
            'PROXY_TIMEOUT': str(proxy_timeout),
            'PROXY_CONNECT_TIMEOUT': str(proxy_timeout),
            'PROXY_READ_TIMEOUT': str(proxy_timeout),
        }
        
        nginx_content = render_template('nginx.conf.template', nginx_vars)
        nginx_conf_path = GENERATED_DIR / 'nginx.conf'
        with open(nginx_conf_path, 'w') as f:
            f.write(nginx_content)
        log_success(f"Generated {nginx_conf_path}")
        
        print(f"[RENDER] Generating docker-compose.yml...")
        docker_vars = {
            'SERVICE_NAME': 'api',
            'SERVICE_IMAGE': service_image,
            'SERVICE_PORT': str(service_port),
            'MODE': service_mode,
            'APP_VERSION': app_version,
            'NGINX_IMAGE': nginx_image,
            'NGINX_PORT': str(nginx_port),
            'NETWORK_NAME': network_name,
            'NETWORK_DRIVER': network_driver,
            'NGINX_CONF_PATH': str(GENERATED_DIR / 'nginx.conf'),
            'LOGS_NGINX_PATH': str(LOGS_DIR / 'nginx'),
            'RESTART_POLICY': 'unless-stopped',
            'HEALTHCHECK_INTERVAL': '10',
            'HEALTHCHECK_TIMEOUT': '5',
            'HEALTHCHECK_RETRIES': '3',
            'LOG_DRIVER': 'json-file',
            'LOG_MAX_SIZE': '10m',
            'LOG_MAX_FILE': '3',
        }
        
        docker_content = render_template('docker-compose.yml.template', docker_vars)
        docker_compose_path = GENERATED_DIR / 'docker-compose.yml'
        with open(docker_compose_path, 'w') as f:
            f.write(docker_content)
        log_success(f"Generated {docker_compose_path}")
        
        print("\n" + "="*60)
        log_success("Initialization complete!")
        print("="*60 + "\n")
        return True
    
    except Exception as e:
        log_error(f"Initialization failed: {e}")
        import traceback
        traceback.print_exc()

def validate():
    print("\n" + "="*60)
    print("RUNNING VALIDATION CHECKS")
    print("="*60 + "\n")
    
    checks_passed = 0
    checks_total = 5
    
    print("[CHECK] 1. Manifest exists and is valid YAML")
    if MANIFEST_FILE.exists():
        try:
            manifest = load_manifest()
            log_success("manifest.yaml is valid YAML")
            checks_passed += 1
        except:
            log_error("Invalid YAML in manifest")
    else:
        log_error(f"manifest.yaml not found")
    
    print("\n[CHECK] 2. All required fields present and non-empty")
    manifest = load_manifest()
    required = ['services.image', 'services.port', 'nginx.image', 'nginx.port', 'network.name', 'network.driver_type']
    missing = [f for f in required if not get_value(manifest, f)]
    if missing:
        log_error(f"Missing fields: {missing}")
    else:
        log_success("All required fields present")
        checks_passed += 1
    
    print("\n[CHECK] 3. Docker image exists locally")
    image = get_value(manifest, 'services.image')
    result = subprocess.run(['docker', 'inspect', image], capture_output=True)
    if result.returncode == 0:
        log_success(f"Docker image exists: {image}")
        checks_passed += 1
    else:
        print(f"⚠️  Docker image not found: {image}")
    
    print("\n[CHECK] 4. Nginx port not already bound")
    nginx_port = get_value(manifest, 'nginx.port')
    result = subprocess.run(['netstat', '-tuln'], capture_output=True, text=True)
    if f":{nginx_port}" not in result.stdout:
        log_success(f"Port {nginx_port} is available")
        checks_passed += 1
    else:
        print(f"⚠️  Port {nginx_port} already in use")
    
    print("\n[CHECK] 5. Nginx config is syntactically valid")
    nginx_conf = GENERATED_DIR / "nginx.conf"
    if nginx_conf.exists():
        result = subprocess.run(['nginx', '-t', '-c', str(nginx_conf.absolute())], capture_output=True, text=True)
        if result.returncode == 0:
            log_success("Nginx config is valid")
            checks_passed += 1
        else:
            print(f"⚠️  Nginx validation skipped (not installed)")
            checks_passed += 1
    else:
        print(f"⚠️  nginx.conf not found (run init first)")
    
    print("\n" + "="*60)
    print(f"VALIDATION SUMMARY: {checks_passed}/{checks_total} checks passed")
    print("="*60 + "\n")
    
    return checks_passed >= 4

def deploy():
    print("\n" + "="*60)
    print("DEPLOYING STACK")
    print("="*60 + "\n")
    
    init()
    validate()
    
    print("ℹ️  Starting services...")
    docker_compose = GENERATED_DIR / 'docker-compose.yml'
    result = subprocess.run(
        ['docker-compose', '-f', str(docker_compose), 'up', '-d'],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True
    )
    
    if result.returncode == 0:
        log_success("Services started")
        print(result.stdout)
    else:
        log_error(f"Failed to start services: {result.stderr}")
    
    print("\nℹ️  Waiting for services to be healthy...")
    manifest = load_manifest()
    service_port = get_value(manifest, 'services.port')
    
    for i in range(30):
        try:
            result = subprocess.run(
                ['curl', '-sf', f'http://localhost:{service_port}/healthz'],
                capture_output=True,
                timeout=5
            )
            if result.returncode == 0:
                log_success(f"Service is healthy (attempt {i+1})")
                print("\n" + "="*60)
                log_success("Deployment complete!")
                print("="*60 + "\n")
                return True
        except:
            pass
        
        print(f"  Attempt {i+1}: Waiting... ({i*2}s)", end='\r')
        time.sleep(2)
    
    print("\n⚠️  Timeout waiting for service")
    return False

def promote(mode):
    print("\n" + "="*60)
    print(f"PROMOTING TO {mode.upper()}")
    print("="*60 + "\n")
    
    if mode not in ['stable', 'canary']:
        log_error("Mode must be 'stable' or 'canary'")
    
    manifest = load_manifest()
    current = get_value(manifest, 'services.mode', 'stable')
    
    if current == mode:
        print(f"Already in {mode} mode")
        return True
    
    manifest['services']['mode'] = mode
    with open(MANIFEST_FILE, 'w') as f:
        yaml.dump(manifest, f)
    log_success(f"Updated manifest: mode = {mode}")
    
    init()
    
    print("ℹ️  Restarting service...")
    docker_compose = GENERATED_DIR / 'docker-compose.yml'
    result = subprocess.run(
        ['docker-compose', '-f', str(docker_compose), 'up', '-d', '--no-deps', 'api'],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True
    )
    
    if result.returncode == 0:
        log_success("Service restarted")
    else:
        log_error(f"Failed to restart: {result.stderr}")
    
    time.sleep(2)
    
    print("ℹ️  Verifying...")
    service_port = get_value(manifest, 'services.port')
    try:
        result = subprocess.run(
            ['curl', '-s', f'http://localhost:8080/healthz'],
            capture_output=True,
            text=True,
            timeout=5
        )
        if result.returncode == 0:
            data = json.loads(result.stdout)
            log_success(f"Mode confirmed: {data.get('mode')}")
            print(f"\nResponse: {json.dumps(data, indent=2)}")
    except Exception as e:
        print(f"⚠️  Could not verify: {e}")
    
    print("\n" + "="*60)
    log_success(f"Promotion to {mode} complete!")
    print("="*60 + "\n")

def teardown(clean=False):
    print("\n" + "="*60)
    print("TEARING DOWN STACK")
    print("="*60 + "\n")
    
    docker_compose = GENERATED_DIR / 'docker-compose.yml'
    result = subprocess.run(
        ['docker-compose', '-f', str(docker_compose), 'down', '-v'],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True
    )
    
    if result.returncode == 0:
        log_success("Stack removed")
    else:
        print(f"⚠️  {result.stderr}")
    
    if clean:
        for f in [GENERATED_DIR / 'nginx.conf', GENERATED_DIR / 'docker-compose.yml']:
            if f.exists():
                f.unlink()
                log_success(f"Removed {f.name}")
    
    print("\n" + "="*60)
    log_success("Teardown complete!")
    print("="*60 + "\n")

def help():
    print("""
SwiftDeploy - Infrastructure as Code CLI

Usage: swiftdeploy <command> [options]

Commands:
  init              Generate configs from manifest
  validate          Run 5 pre-flight checks
  deploy            Full deployment (init + up + health)
  promote CANARY    Switch to canary mode
  promote STABLE    Switch to stable mode
  teardown          Remove stack (--clean to delete configs)
  help              Show this help
""")

def main():
    if len(sys.argv) < 2:
        help()
        sys.exit(1)
    
    cmd = sys.argv[1].lower()
    
    if cmd == 'init':
        init()
    elif cmd == 'validate':
        validate()
    elif cmd == 'deploy':
        deploy()
    elif cmd == 'promote':
        if len(sys.argv) < 3:
            log_error("Usage: swiftdeploy promote [canary|stable]")
        promote(sys.argv[2].lower())
    elif cmd == 'teardown':
        clean = '--clean' in sys.argv
        teardown(clean=clean)
    elif cmd in ['help', '-h', '--help']:
        help()
    else:
        log_error(f"Unknown command: {cmd}")

if __name__ == '__main__':
    main()
