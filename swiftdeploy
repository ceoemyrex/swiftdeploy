class Colors:
    GREEN = '\033[92m'
    RED = '\033[91m'
    YELLOW = '\033[93m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    RESET = '\033[0m'
    BOLD = '\033[1m'

def log_success(msg: str):
    print(f"{Colors.GREEN}✅ {msg}{Colors.RESET}")

def log_error(msg: str):
    print(f"{Colors.RED}❌ {msg}{Colors.RESET}")

def log_warning(msg: str):
    print(f"{Colors.YELLOW}⚠️  {msg}{Colors.RESET}")

def log_info(msg: str):
    print(f"{Colors.BLUE}ℹ️  {msg}{Colors.RESET}")

def append_history(event: Dict):
    """Append event to history.jsonl"""
    with open(HISTORY_FILE, 'a') as f:
        f.write(json.dumps({
            'timestamp': datetime.utcnow().isoformat() + 'Z',
            **event
        }) + '\n')

def load_manifest() -> Dict:
    if not MANIFEST_FILE.exists():
        log_error(f"Manifest not found: {MANIFEST_FILE}")
        sys.exit(1)
    try:
        with open(MANIFEST_FILE, 'r') as f:
            return yaml.safe_load(f)
    except Exception as e:
        log_error(f"Error loading manifest: {e}")
        sys.exit(1)

def save_manifest(manifest: Dict):
    try:
        with open(MANIFEST_FILE, 'w') as f:
            yaml.dump(manifest, f, default_flow_style=False, sort_keys=False)
        log_success("Manifest saved")
    except Exception as e:
        log_error(f"Error saving manifest: {e}")
        sys.exit(1)

def get_value(obj: Dict, path: str, default=None):
    keys = path.split('.')
    val = obj
    for key in keys:
        if isinstance(val, dict):
            val = val.get(key)
        else:
            return default
    return val if val is not None else default

def render_template(template_name: str, variables: Dict[str, str]) -> str:
    template_file = TEMPLATES_DIR / template_name
    if not template_file.exists():
        log_error(f"Template not found: {template_file}")
        sys.exit(1)
    
    with open(template_file, 'r') as f:
        content = f.read()
    
    for key, value in variables.items():
        placeholder = f"{{{{{key}}}}}"
        content = content.replace(placeholder, str(value))
    
    return content

