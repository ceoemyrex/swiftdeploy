def init():
    """Initialize - parse manifest and generate configs"""
    print("\n" + "="*60)
    print(f"{Colors.BOLD}INITIALIZING SWIFTDEPLOY{Colors.RESET}")
    print("="*60 + "\n")
    
    try:
        manifest = load_manifest()
        log_success("Manifest loaded")
        
        GENERATED_DIR.mkdir(exist_ok=True)
        log_success(f"Created {GENERATED_DIR}")
        
        LOGS_DIR.mkdir(exist_ok=True)
        log_success(f"Created {LOGS_DIR}")
        
        (LOGS_DIR / 'nginx').mkdir(exist_ok=True)
        
        service_image = get_value(manifest, 'services.image')
        service_port = get_value(manifest, 'services.port')
        service_mode = get_value(manifest, 'services.mode', 'stable')
        nginx_image = get_value(manifest, 'nginx.image')
        nginx_port = get_value(manifest, 'nginx.port')
        proxy_timeout = get_value(manifest, 'nginx.proxy_timeout', 30)
        network_name = get_value(manifest, 'network.name')
        network_driver = get_value(manifest, 'network.driver_type')
        app_version = get_value(manifest, 'app_version', '1.0.0')
        
        print(f"\n{Colors.BOLD}Configuration:{Colors.RESET}")
        print(f"  Service: {service_image}:{service_port}")
        print(f"  Mode: {service_mode}")
        print(f"  Nginx: {nginx_image}:{nginx_port}")
        print(f"  Network: {network_name} ({network_driver})\n")
        
        # Generate nginx.conf
        print(f"{Colors.BLUE}[RENDER]{Colors.RESET} Generating nginx.conf...")
        nginx_vars = {
            'SERVICE_NAME': 'api',
            'SERVICE_PORT': str(service_port),
            'NGINX_PORT': str(nginx_port),
            'PROXY_TIMEOUT': str(proxy_timeout),
            'PROXY_CONNECT_TIMEOUT': str(proxy_timeout),
            'PROXY_READ_TIMEOUT': str(proxy_timeout),
        }
        
        nginx_content = render_template('nginx.conf.template', nginx_vars)
        nginx_conf_path = GENERATED_DIR / 'nginx.conf'
        with open(nginx_conf_path, 'w') as f:
            f.write(nginx_content)
        log_success(f"Generated {nginx_conf_path}")
        
        # Generate docker-compose.yml
        print(f"{Colors.BLUE}[RENDER]{Colors.RESET} Generating docker-compose.yml...")
        docker_vars = {
            'SERVICE_NAME': 'api',
            'SERVICE_IMAGE': service_image,
            'SERVICE_PORT': str(service_port),
            'MODE': service_mode,
            'APP_VERSION': app_version,
            'NGINX_IMAGE': nginx_image,
            'NGINX_PORT': str(nginx_port),
            'NETWORK_NAME': network_name,
            'NETWORK_DRIVER': network_driver,
            'NGINX_CONF_PATH': str(GENERATED_DIR / 'nginx.conf'),
            'LOGS_NGINX_PATH': str(LOGS_DIR / 'nginx'),
            'OPA_PORT': '8181',
            'POLICIES_PATH': str(POLICIES_DIR),
            'RESTART_POLICY': 'unless-stopped',
            'HEALTHCHECK_INTERVAL': '10',
            'HEALTHCHECK_TIMEOUT': '5',
            'HEALTHCHECK_RETRIES': '3',
            'LOG_DRIVER': 'json-file',
            'LOG_MAX_SIZE': '10m',
            'LOG_MAX_FILE': '3',
