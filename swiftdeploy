def validate():
    """Validate manifest and environment"""
    print("\n" + "="*60)
    print(f"{Colors.BOLD}RUNNING VALIDATION CHECKS{Colors.RESET}")
    print("="*60 + "\n")
    
    checks_passed = 0
    checks_total = 5
    
    print("[CHECK] 1. Manifest exists and is valid YAML")
    if MANIFEST_FILE.exists():
        try:
            manifest = load_manifest()
            log_success("manifest.yaml is valid YAML")
            checks_passed += 1
        except:
            log_error("Invalid YAML in manifest")
    else:
        log_error(f"manifest.yaml not found")
    
    print("\n[CHECK] 2. All required fields present and non-empty")
    manifest = load_manifest()
    required = ['services.image', 'services.port', 'nginx.image', 'nginx.port', 'network.name', 'network.driver_type']
    missing = [f for f in required if not get_value(manifest, f)]
    if missing:
        log_error(f"Missing fields: {missing}")
    else:
        log_success("All required fields present")
        checks_passed += 1
    
    print("\n[CHECK] 3. Docker image exists locally")
    image = get_value(manifest, 'services.image')
    result = subprocess.run(['docker', 'inspect', image], capture_output=True)
    if result.returncode == 0:
        log_success(f"Docker image exists: {image}")
        checks_passed += 1
    else:
        print(f"⚠️  Docker image not found: {image}")
    
    print("\n[CHECK] 4. Nginx port not already bound")
    nginx_port = get_value(manifest, 'nginx.port')
    result = subprocess.run(['netstat', '-tuln'], capture_output=True, text=True)
    if f":{nginx_port}" not in result.stdout:
        log_success(f"Port {nginx_port} is available")
        checks_passed += 1
    else:
        print(f"⚠️  Port {nginx_port} already in use")
    
    print("\n[CHECK] 5. Nginx config is syntactically valid")
    nginx_conf = GENERATED_DIR / "nginx.conf"
    if nginx_conf.exists():
        result = subprocess.run(['nginx', '-t', '-c', str(nginx_conf.absolute())], capture_output=True, text=True)
        if result.returncode == 0:
            log_success("Nginx config is valid")
            checks_passed += 1
        else:
            print(f"⚠️  Nginx validation skipped (not installed)")
            checks_passed += 1
    else:
        print(f"⚠️  nginx.conf not found (run init first)")
    
    print("\n" + "="*60)
    print(f"VALIDATION SUMMARY: {checks_passed}/{checks_total} checks passed")
    print("="*60 + "\n")
    
    return checks_passed >= 4

def deploy():
    """Full deployment"""
    print("\n" + "="*60)
    print(f"{Colors.BOLD}DEPLOYING STACK{Colors.RESET}")
    print("="*60 + "\n")
    
    # Pre-deploy policy check
    if not check_pre_deploy():
        log_error("Deployment blocked by policy")
        append_history({'event': 'deploy_blocked', 'reason': 'policy_violation'})
        sys.exit(1)
    
    init()
    validate()
    
    log_info("Starting services...")
    docker_compose = GENERATED_DIR / 'docker-compose.yml'
    result = subprocess.run(
        ['docker-compose', '-f', str(docker_compose), 'up', '-d'],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True
    )
    
    if result.returncode == 0:
        log_success("Services started")
        print(result.stdout)
        append_history({'event': 'deploy_started'})
    else:
        log_error(f"Failed to start services: {result.stderr}")
        sys.exit(1)
    
    log_info("Waiting for services to be healthy...")
    manifest = load_manifest()
    service_port = get_value(manifest, 'services.port')
    
    for i in range(30):
        try:
            result = subprocess.run(
                ['curl', '-sf', f'http://localhost:{service_port}/healthz'],
                capture_output=True,
                timeout=5
            )
            if result.returncode == 0:
                log_success(f"Service is healthy (attempt {i+1})")
                print("\n" + "="*60)
                log_success("Deployment complete!")
                append_history({'event': 'deploy_complete'})
                print("="*60 + "\n")
                return True
        except:
            pass
        
        print(f"  Attempt {i+1}: Waiting... ({i*2}s)", end='\r')
        time.sleep(2)
    
    log_warning("Timeout waiting for service")
    return False

def promote(mode: str):
    """Promote to canary or stable"""
    print("\n" + "="*60)
    print(f"{Colors.BOLD}PROMOTING TO {mode.upper()}{Colors.RESET}")
    print("="*60 + "\n")
    
    if mode not in ['stable', 'canary']:
        log_error("Mode must be 'stable' or 'canary'")
        sys.exit(1)
    
    # Pre-promote policy check (only when promoting TO canary)
    if mode == 'canary':
        if not check_pre_promote():
            log_error("Promotion blocked by policy")
            append_history({'event': 'promote_blocked', 'target_mode': mode, 'reason': 'policy_violation'})
            sys.exit(1)
    
    manifest = load_manifest()
    current = get_value(manifest, 'services.mode', 'stable')
    
    if current == mode:
        log_warning(f"Already in {mode} mode")
        return True
    
    manifest['services']['mode'] = mode
    save_manifest(manifest)
    log_success(f"Updated manifest: mode = {mode}")
    
    init()
    
    log_info("Restarting service...")
    docker_compose = GENERATED_DIR / 'docker-compose.yml'
    result = subprocess.run(
        ['docker-compose', '-f', str(docker_compose), 'up', '-d', '--no-deps', 'api'],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True
    )
    
    if result.returncode == 0:
        log_success("Service restarted")
    else:
        log_error(f"Failed to restart: {result.stderr}")
        sys.exit(1)
    
    time.sleep(2)
    
    log_info("Verifying...")
    service_port = get_value(manifest, 'services.port')
    try:
        result = subprocess.run(
            ['curl', '-s', f'http://localhost:8080/healthz'],
            capture_output=True,
            text=True,
            timeout=5
        )
        if result.returncode == 0:
            data = json.loads(result.stdout)
            log_success(f"Mode confirmed: {data.get('mode')}")
            print(f"\nResponse: {json.dumps(data, indent=2)}")
            append_history({'event': f'promote_to_{mode}', 'success': True})
    except Exception as e:
        log_warning(f"Could not verify: {e}")
    
    print("\n" + "="*60)
    log_success(f"Promotion to {mode} complete!")
    print("="*60 + "\n")

def teardown(clean: bool = False):
    """Teardown stack"""
    print("\n" + "="*60)
    print(f"{Colors.BOLD}TEARING DOWN STACK{Colors.RESET}")
    print("="*60 + "\n")
    
    docker_compose = GENERATED_DIR / 'docker-compose.yml'
    result = subprocess.run(
        ['docker-compose', '-f', str(docker_compose), 'down', '-v'],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True
    )
    
    if result.returncode == 0:
        log_success("Stack removed")
    else:
        log_warning(f"{result.stderr}")
    
    if clean:
        for f in [GENERATED_DIR / 'nginx.conf', GENERATED_DIR / 'docker-compose.yml']:
            if f.exists():
                f.unlink()
                log_success(f"Removed {f.name}")
    
    print("\n" + "="*60)
    log_success("Teardown complete!")
    print("="*60 + "\n")

def status():
    """Live status dashboard"""
    print(f"\n{Colors.BOLD}SwiftDeploy Status Dashboard{Colors.RESET}")
    print("Press Ctrl+C to exit\n")
    
    try:
        while True:
            # Clear screen
            os.system('clear' if os.name != 'nt' else 'cls')
            
            # Get metrics
            metrics = scrape_metrics()
            
            # Display
            print(f"{Colors.BOLD}📊 SwiftDeploy Status - {datetime.now().strftime('%H:%M:%S')}{Colors.RESET}")
            print("="*60)
            print()
            print(f"Throughput: {metrics.get('total_requests', 0):.0f} requests")
            print(f"Error Rate: {metrics.get('error_rate', 0)*100:.2f}%")
            print(f"P99 Latency: {metrics.get('p99_latency_ms', 0):.0f}ms")
            print(f"Uptime: {metrics.get('uptime_seconds', 0):.0f}s")
            print()
            
            # Append to history
            append_history({'event': 'metrics_sample', 'metrics': metrics})
            
            time.sleep(5)
    
    except KeyboardInterrupt:
        print(f"\n{Colors.YELLOW}Status dashboard stopped{Colors.RESET}")

def audit():
    """Generate audit report"""
    if not HISTORY_FILE.exists():
        log_warning("No history found")
        return
    
    print("\n" + "="*60)
    print(f"{Colors.BOLD}GENERATING AUDIT REPORT{Colors.RESET}")
    print("="*60 + "\n")
    
    history = []
    with open(HISTORY_FILE, 'r') as f:
        for line in f:
            try:
                history.append(json.loads(line))
            except:
                pass
    
    # Generate report
    report = "# SwiftDeploy Audit Report\n\n"
    report += f"Generated: {datetime.now().isoformat()}\n\n"
    report += "## Events\n\n"
    
    for event in history:
        ts = event.get('timestamp', 'unknown')
        evt_type = event.get('event', 'unknown')
        report += f"- {ts}: {evt_type}\n"
    
    # Save report
    report_file = PROJECT_ROOT / 'audit_report.md'
    with open(report_file, 'w') as f:
        f.write(report)
    
    log_success(f"Audit report generated: {report_file}")
    print(report)

def help():
    print(f"""
{Colors.BOLD}SwiftDeploy - Infrastructure as Code CLI{Colors.RESET}

Usage: swiftdeploy <command> [options]

Commands:
  init              Generate configs from manifest
  validate          Run 5 pre-flight checks
  deploy            Full deployment with policy gates
  promote CANARY    Switch to canary mode (with policy check)
  promote STABLE    Switch to stable mode
  status            Live status dashboard
  audit             Generate audit report
  teardown          Remove stack (--clean to delete configs)
  help              Show this help
""")

def main():
    if len(sys.argv) < 2:
        help()
        sys.exit(1)
    
    cmd = sys.argv[1].lower()
    
    if cmd == 'init':
        init()
    elif cmd == 'validate':
        validate()
    elif cmd == 'deploy':
        deploy()
    elif cmd == 'promote':
        if len(sys.argv) < 3:
            log_error("Usage: swiftdeploy promote [canary|stable]")
            sys.exit(1)
        promote(sys.argv[2].lower())
    elif cmd == 'status':
        status()
    elif cmd == 'audit':
        audit()
    elif cmd == 'teardown':
        clean = '--clean' in sys.argv
        teardown(clean=clean)
    elif cmd in ['help', '-h', '--help']:
        help()
    else:
        log_error(f"Unknown command: {cmd}")
        help()
        sys.exit(1)

if __name__ == '__main__':
    main()
