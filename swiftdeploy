def query_opa(package: str, data: Dict) -> Dict:
    """Query OPA for a policy decision"""
    try:
        response = requests.post(
            f'http://opa:8181/v1/data/{package}',
            json={'input': data},
            timeout=5
        )
        
        if response.status_code != 200:
            return {
                'allowed': None,
                'reason': f'OPA returned {response.status_code}',
                'severity': 'warning'
            }
        
        result = response.json()['result']
        allowed = result.get('allow', False)
        denies = result.get('deny', [])
        
        return {
            'allowed': allowed,
            'reason': denies[0] if denies else 'Approved',
            'severity': 'error' if not allowed else 'info',
            'all_reasons': denies
        }
    
    except requests.ConnectionError:
        return {
            'allowed': None,
            'reason': 'OPA unavailable - cannot verify policy',
            'severity': 'warning'
        }
    except requests.Timeout:
        return {
            'allowed': None,
            'reason': 'OPA timeout - cannot verify policy',
            'severity': 'warning'
        }
    except Exception as e:
        return {
            'allowed': None,
            'reason': f'OPA error: {str(e)}',
            'severity': 'warning'
        }

def get_system_stats() -> Dict:
    """Get current system statistics"""
    disk = psutil.disk_usage('/')
    cpu_load = psutil.getloadavg()[0]  # 1-minute load average
    mem = psutil.virtual_memory()
    
    return {
        'disk_free_gb': disk.free / (1024**3),
        'cpu_load': cpu_load,
        'mem_available_percent': mem.available / mem.total * 100
    }

def scrape_metrics() -> Dict:
    """Scrape /metrics endpoint and parse metrics"""
    try:
        response = requests.get('http://localhost:8080/metrics', timeout=5)
        if response.status_code != 200:
            return {}
        
        metrics = {}
        
        # Parse Prometheus text format
        for line in response.text.split('\n'):
            if line.startswith('#'):
                continue
            if not line.strip():
                continue
            
            if 'http_requests_total' in line and 'status_code="500"' in line:
                # Count 500s
                parts = line.split('}')
                if len(parts) > 1:
                    try:
                        count = float(parts[1].strip())
                        metrics['error_requests'] = count
                    except:
                        pass
            
            elif 'http_requests_total' in line and 'status_code' in line:
                parts = line.split('}')
                if len(parts) > 1:
                    try:
                        count = float(parts[1].strip())
                        if 'total_requests' not in metrics:
                            metrics['total_requests'] = 0
                        metrics['total_requests'] += count
                    except:
                        pass
            
            elif 'http_request_duration_seconds_bucket' in line:
                # Parse latency buckets
                try:
                    if 'le="0.5"' in line:  # P99 approximation
                        value = float(line.split('}')[1].strip())
                        metrics['p99_latency_ms'] = 500  # Use bucket value
                except:
                    pass
            
            elif 'app_uptime_seconds' in line and '{' not in line:
                try:
                    value = float(line.split()[-1])
                    metrics['uptime_seconds'] = value
                except:
                    pass
        
        # Calculate error rate
        error_requests = metrics.get('error_requests', 0)
        total_requests = metrics.get('total_requests', 1)
        metrics['error_rate'] = error_requests / total_requests if total_requests > 0 else 0
        metrics['p99_latency_ms'] = metrics.get('p99_latency_ms', 0)
        metrics['uptime_seconds'] = metrics.get('uptime_seconds', 0)
        
        return metrics
    
    except Exception as e:
        log_warning(f"Could not scrape metrics: {e}")
        return {}

def check_pre_deploy() -> bool:
    """Check infrastructure policy before deploy"""
    log_info("Checking pre-deploy policies...")
    
    stats = get_system_stats()
    log_info(f"System stats: Disk {stats['disk_free_gb']:.1f}GB, CPU {stats['cpu_load']:.2f}, Mem {stats['mem_available_percent']:.1f}%")
    
    response = query_opa('infrastructure/allow_deploy', stats)
    
    if response['allowed'] is None:
        log_warning(f"{response['reason']}")
        return True  # Warn but allow if OPA unavailable
    
    if not response['allowed']:
        log_error(f"Pre-deploy check failed: {response['reason']}")
        return False
    
    log_success(f"Pre-deploy check passed")
    return True

def check_pre_promote() -> bool:
    """Check canary policy before promote"""
    log_info("Checking pre-promote policies...")
    
    metrics = scrape_metrics()
    if not metrics:
        log_warning("Could not scrape metrics")
        return True  # Warn but allow
    
    log_info(f"Metrics: Error rate {metrics.get('error_rate', 0)*100:.2f}%, P99 {metrics.get('p99_latency_ms', 0):.0f}ms, Uptime {metrics.get('uptime_seconds', 0):.0f}s")
    
    response = query_opa('canary/allow_promote', metrics)
    
    if response['allowed'] is None:
        log_warning(f"{response['reason']}")
        return True  # Warn but allow if OPA unavailable
    
    if not response['allowed']:
        log_error(f"Pre-promote check failed: {response['reason']}")
        return False
    
    log_success(f"Pre-promote check passed")
    return True

