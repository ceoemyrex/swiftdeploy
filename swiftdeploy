# MAIN CLI
# ============================================================================

def print_help():
    """Print help message"""
    help_text = f"""
{Colors.BOLD}SwiftDeploy - Infrastructure as Code CLI{Colors.RESET}

{Colors.BOLD}Usage:{Colors.RESET}
    swiftdeploy <command> [options]

{Colors.BOLD}Commands:{Colors.RESET}
    init              Parse manifest and generate configs
    validate          Run pre-flight validation checks (5 checks)
    deploy            Deploy stack (init + up + health checks)
    promote CANARY    Switch to canary mode
    promote STABLE    Switch to stable mode
    teardown          Remove stack (--clean to delete configs)
    help              Show this help message

{Colors.BOLD}Examples:{Colors.RESET}
    swiftdeploy init
    swiftdeploy validate
    swiftdeploy deploy
    swiftdeploy promote canary
    swiftdeploy promote stable
    swiftdeploy teardown
    swiftdeploy teardown --clean

{Colors.BOLD}Files:{Colors.RESET}
    manifest.yaml              Source of truth (edit this)
    generated/nginx.conf       Generated (auto)
    generated/docker-compose.yml Generated (auto)
    logs/                      Application logs
"""
    print(help_text)

def main():
    """Main CLI entry point"""
    if len(sys.argv) < 2:
        print_help()
        sys.exit(1)
    
    command = sys.argv[1].lower()
    
    if command == 'help' or command == '-h' or command == '--help':
        print_help()
        sys.exit(0)
    
    elif command == 'init':
        success = init()
        sys.exit(0 if success else 1)
    
    elif command == 'validate':
        success, messages = validate()
        sys.exit(0 if success else 1)
    
    elif command == 'deploy':
        success = deploy()
        sys.exit(0 if success else 1)
    
    elif command == 'promote':
        if len(sys.argv) < 3:
            log_error("Usage: swiftdeploy promote [canary|stable]")
            sys.exit(1)
        mode = sys.argv[2].lower()
        success = promote(mode)
        sys.exit(0 if success else 1)
    
    elif command == 'teardown':
        clean = '--clean' in sys.argv
        success = teardown(clean=clean)
        sys.exit(0 if success else 1)
    
    else:
        log_error(f"Unknown command: {command}")
        print_help()
        sys.exit(1)

if __name__ == '__main__':
    main()
