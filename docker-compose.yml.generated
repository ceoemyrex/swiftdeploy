# Generated by SwiftDeploy - DO NOT EDIT MANUALLY
# Generated from: manifest.yaml

version: '3.9'

services:
  api:
    image: swift-deploy-1-node:latest
    container_name: api
    ports:
      - "3000"
    environment:
      MODE: stable
      APP_VERSION: 1.0.0
      APP_PORT: 3000
    networks:
      - swiftdeploy-net
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "python -c 'import urllib.request; urllib.request.urlopen(\"http://localhost:3000/healthz\")'"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    volumes:
      - logs:/app/logs
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    user: appuser

  nginx:
    image: nginx:latest
    container_name: nginx
    ports:
      - "8080:8080"
    volumes:
      - /home/ubuntu/swiftdeploy/generated/nginx.conf:/etc/nginx/nginx.conf:ro
      - /home/ubuntu/swiftdeploy/logs/nginx:/var/log/nginx
    networks:
      - swiftdeploy-net
    depends_on:
      api:
        condition: service_healthy
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://localhost:8080/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  swiftdeploy-net:
    driver: bridge

volumes:
  logs:
    driver: local
